# Origen público exacto desde el que se sirve la aplicación, sin barra final.
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
UPLOAD_DIR=./uploads

# Servicio de autenticación compatible con el contrato de docs/auth.md.
AUTH_URL=http://localhost:3001
AUTH_APP_SLUG=forms
# Roles que pueden entrar al panel privado, separados por coma.
AUTH_ALLOWED_ROLES=docente,admin

# Express espera una base PostgreSQL accesible en esta URL.
DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5432/forms

# Docker Compose usa estas contraseñas para su propia base.
POSTGRES_PASSWORD=forms_local
FORMS_DB_PASSWORD=forms_app_local

# Nombre visible del producto en el frontend. Se aplica al compilar.
VITE_APP_NAME=Forms
