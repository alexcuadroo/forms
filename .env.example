# Desarrollo local con Vite y Express.
PUBLIC_ORIGIN=http://localhost:5173
PORT=3000
UPLOAD_DIR=./uploads

# Para probar el panel docente, usá una instancia de auth con cookies compatibles con localhost.
AUTH_URL=https://auth.edualex.uy

# Express espera una base PostgreSQL accesible en esta URL.
DATABASE_URL=postgresql://forms:forms_local@127.0.0.1:5432/forms

# Docker Compose usa esta contraseña para su propia base. Cambiala antes de desplegar.
POSTGRES_PASSWORD=forms_local
